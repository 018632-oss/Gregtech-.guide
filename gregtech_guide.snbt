	quests: [
		{
			description: ["This chapter walks you through the early game of GregTech CEu Modern.", "Tip: hover over any item and press R to see how it is made, or U to see what it is used for (JEI).", "Tip: sneak and right-click the Field Guide book for 3D previews of the Coke Oven and Primitive Blast Furnace.", "Click the check below to begin."]
			icon: "minecraft:book"
			id: "C9D9327E0880242A"
			tasks: [{
				id: "68C155A56C2B11EF"
				type: "checkmark"
			}]
			title: "Welcome to the GregTech Guide"
			x: -1.5d
			y: 0.0d
		}
		{
			dependencies: ["C9D9327E0880242A"]
			description: ["Collect at least 8 logs. You need planks and sticks for a crafting table and tools. Logs are also what the Coke Oven later turns into charcoal."]
			icon: "minecraft:oak_log"
			id: "41AE147B44BE306F"
			tasks: [{
				id: "D805CCE2D26B882C"
				consume_items: false
