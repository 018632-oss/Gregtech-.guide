				count: 8L
				type: "item"
			}]
			title: "Gather Wood"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["41AE147B44BE306F"]
			description: ["Craft a crafting table from planks. Almost every early recipe starts here."]
			icon: "minecraft:crafting_table"
			id: "7A09B37EA29CFFDD"
			tasks: [{
				id: "4B705959645B8E73"
				consume_items: false
